{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        "cd backend && npm install --omit=dev"
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" }
      ],
      "commands": ["true"]
    }
  },
  "deploy": {
    "startCommand": "node backend/server.js",
    "variables": {
      "TZ": "Asia/Karachi"
    }
  }
}

