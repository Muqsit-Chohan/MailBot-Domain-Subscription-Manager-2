{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        { "src": "backend/package.json", "dest": "backend/package.json" },
        { "src": "backend/package-lock.json", "dest": "backend/package-lock.json" },
        { "src": "backend", "dest": "backend" },
        "cd backend && npm install --omit=dev"
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" }
      ],
      "commands": ["true"]
    }
  },
  "deploy": {
    "startCommand": "if [ -d backend ]; then node backend/server.js; else node server.js; fi",
    "variables": {
      "TZ": "Asia/Karachi"
    }
  }
}
