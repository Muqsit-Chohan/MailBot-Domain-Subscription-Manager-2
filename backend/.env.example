MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mailbot
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://mailbot-flash.vercel.app
# Set this in Railway Variables too; local .env changes do not update deployments.
CLIENT_URL=https://mailbot-flash.vercel.app

# Optional integrations
# When set, all emails use Resend HTTPS instead of SMTP (works on Railway Free).
RESEND_API_KEY=
# Testing sender only delivers to your Resend account email.
# For other recipients, replace with a sender on your verified domain.
EMAIL_FROM=MailBot <onboarding@resend.dev>
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
