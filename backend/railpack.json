{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        { "src": "package.json", "dest": "package.json" },
        { "src": "package-lock.json", "dest": "package-lock.json" },
        "npm install --omit=dev"
      ]
    }
  },
  "deploy": {
    "startCommand": "node server.js",
    "variables": {
      "TZ": "Asia/Karachi"
    }
  }
}
